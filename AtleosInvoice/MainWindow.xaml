<Window x:Class="AtleosInvoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NCR Atleos Invoice Studio" Icon="/AtleosInvoice;component/Assets/AppIcon.ico" Height="1020" Width="1600" MinHeight="720" MinWidth="1100" WindowState="Maximized"
        Background="#F1F3F4" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,3,0,8"/>
            <Setter Property="BorderBrush" Value="#CCD2D4"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="0,3,0,8"/>
            <Setter Property="BorderBrush" Value="#CCD2D4"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#45534F"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#173D34"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#173D34" Padding="20,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="New" Click="New_Click"/><Button Content="Open" Click="Open_Click"/>
                    <Button Content="Save" Click="Save_Click"/><Button Content="Print" Click="Print_Click"/>
                    <Button Content="Export PDF" Click="Export_Click" Background="#8EA83B"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="16" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Invoice Details" FontWeight="Bold" FontSize="15" Margin="0,0,0,10" Foreground="#173D34"/>
                        <TextBlock Text="Business Name" Style="{StaticResource Label}"/><TextBox Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Business Address And Contact" Style="{StaticResource Label}"/><TextBox Text="{Binding BusinessAddress, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Currency" Style="{StaticResource Label}"/>
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="GHS - Ghana Cedis" Tag="GHS"/><ComboBoxItem Content="USD - US Dollars" Tag="USD"/>
                        </ComboBox>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Invoice Number" Style="{StaticResource Label}"/><TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Division" Style="{StaticResource Label}"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding Division, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="PS"/><ComboBoxItem Content="SSB"/><ComboBoxItem Content="WCS"/></ComboBox></StackPanel>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Customer Name" Style="{StaticResource Label}"/><TextBox Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Customer City" Style="{StaticResource Label}"/><TextBox Text="{Binding ClientCity, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                        <TextBlock Text="Customer Address" Style="{StaticResource Label}"/><TextBox Text="{Binding ClientAddress, UpdateSourceTrigger=PropertyChanged}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Customer Phone" Style="{StaticResource Label}"/><TextBox Text="{Binding ClientPhone, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Invoice Date" Style="{StaticResource Label}"/>
                                <DatePicker SelectedDate="{Binding InvoiceDatePickerValue, UpdateSourceTrigger=PropertyChanged}">
                                    <DatePicker.Resources>
                                        <Style TargetType="{x:Type DatePickerTextBox}">
                                            <Setter Property="IsReadOnly" Value="True"/>
                                        </Style>
                                    </DatePicker.Resources>
                                </DatePicker>
                            </StackPanel>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Your Reference" Style="{StaticResource Label}"/><TextBox Text="{Binding YourReference, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="SSF No." Style="{StaticResource Label}"/><TextBox Text="{Binding SsfNumber, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                        <TextBlock Text="FOB" Style="{StaticResource Label}"/><TextBox Text="{Binding Fob, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Invoice Title" Style="{StaticResource Label}"/><TextBox Text="{Binding InvoiceTitle, UpdateSourceTrigger=PropertyChanged}"/>
                        <Separator Margin="0,8"/><TextBlock Text="Line Items" FontWeight="Bold" FontSize="14" Foreground="#173D34"/>
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="#D9DEDC" BorderThickness="1" Padding="9" Margin="0,6">
                                    <StackPanel>
                                        <TextBlock Text="Description" Style="{StaticResource Label}"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Quantity" Style="{StaticResource Label}"/><TextBox Text="{Binding Quantity, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Unit Price" Style="{StaticResource Label}"/><TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                                            <StackPanel Grid.Column="2" Margin="5,0,0,0"><TextBlock Text="Discount (%)" Style="{StaticResource Label}"/><TextBox Text="{Binding DiscountPercent, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                                            <StackPanel Grid.Column="3" Margin="5,0,0,0"><TextBlock Text="Line Total" Style="{StaticResource Label}"/><TextBlock FontWeight="Bold" FontSize="15" Margin="0,7,0,0"><TextBlock.Text><MultiBinding StringFormat="{}{0} {1:N2}"><Binding Path="DataContext.CurrencyCode" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="Total"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                                        </Grid>
                                        <Button Content="Remove Line" HorizontalAlignment="Right" Padding="8,4" Click="RemoveLine_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Add Line Item" Click="AddLine_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="Taxes And Totals (Rates Are Editable)" FontWeight="Bold" FontSize="14" Foreground="#173D34" Margin="0,10,0,5"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="GETFund Rate (%)" Style="{StaticResource Label}"/><TextBox Text="{Binding GetFundRate, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="NHIL Rate (%)" Style="{StaticResource Label}"/><TextBox Text="{Binding NhilRate, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="VAT Rate (%)" Style="{StaticResource Label}"/><TextBox Text="{Binding VatRate, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                        <TextBlock Text="Payment Method" Style="{StaticResource Label}"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="Cheque"/><ComboBoxItem Content="Bank Transfer"/></ComboBox>
                        <TextBlock Text="Due Date / Terms" Style="{StaticResource Label}"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding DueDate, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="Within 15 days"/><ComboBoxItem Content="Within 30 days"/><ComboBoxItem Content="Within 45 days"/></ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel><TextBlock Text="LIVE PREVIEW  ·  A4 PORTRAIT" FontWeight="Bold" Foreground="#45534F" VerticalAlignment="Center"/><TextBlock Text="Values update as you type" DockPanel.Dock="Right" Foreground="#77827E" VerticalAlignment="Center"/></DockPanel>
                <Border Grid.Row="1" Background="#DDE2E0" Padding="8" CornerRadius="5">
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="InvoicePage" Width="595" Height="842" Background="White" Padding="45,38" BorderBrush="#C7CDCB" BorderThickness="1">
                            <Grid x:Name="PreviewPage" ClipToBounds="True">
                                <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="26"/><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="108"/><RowDefinition Height="48"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding BusinessName}" FontSize="15" FontWeight="Bold" FontStyle="Italic"/><TextBlock Text="{Binding BusinessAddress}" FontSize="9" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                            <Image Source="/AtleosInvoice;component/Assets/Icon.jpeg" Width="38" Height="38" Stretch="Uniform" Margin="0,0,5,0"/>
                                            <StackPanel VerticalAlignment="Center"><TextBlock Text="NCR" FontSize="13" FontWeight="Bold" Foreground="#435B51"/><TextBlock Text="ATLEOS" FontSize="13" FontWeight="Bold" Foreground="#435B51"/></StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="{Binding InvoiceNumber}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Division, StringFormat=Division:  {0}}" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Height="2" Background="#303B37" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="INVOICE" FontSize="15" FontWeight="Bold" FontStyle="Italic" Margin="16,0"/><Border Grid.Column="2" Height="2" Background="#303B37" VerticalAlignment="Center"/></Grid>
                                <Grid Grid.Row="2" Margin="-2,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border BorderBrush="#253B33" BorderThickness="1.6" CornerRadius="9" Padding="9,5"><Grid><Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="ATTN:" FontSize="8.5" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="{Binding ClientName, StringFormat='Customer    {0}'}" FontSize="8.5"/><TextBlock Grid.Row="2" Text="{Binding ClientAddress, StringFormat='Address      {0}'}" FontSize="8.5"/><StackPanel Grid.Row="3" Orientation="Horizontal"><TextBlock Text="{Binding ClientCity, StringFormat='City         {0}'}" FontSize="8.5"/><TextBlock Text="{Binding ClientPhone, StringFormat='    Phone  {0}'}" FontSize="8.5"/></StackPanel></Grid></Border>
                                    <Border Grid.Column="2" BorderBrush="#253B33" BorderThickness="1.6" CornerRadius="9" Padding="9,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Date" FontSize="8.5"/><TextBlock Grid.Column="1" Text="{Binding InvoiceDateFormatted}" FontSize="8.5" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="Your Ref." FontSize="8.5"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding YourReference}" FontSize="8.5"/><TextBlock Grid.Row="2" Text="SSF NO." FontSize="8.5"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SsfNumber}" FontSize="8.5"/><TextBlock Grid.Row="3" Text="FOB" FontSize="8.5"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Fob}" FontSize="8.5"/></Grid></Border>
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,0,0,0"><Grid.RowDefinitions><RowDefinition Height="17"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="4" Background="#F1F2F1" BorderBrush="#394440" BorderThickness="0.7"/><TextBlock Text="Quantity" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="Description" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Grid.Column="2" Text="Unit Price" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Grid.Column="3" Text="Total" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <Border Grid.Row="1" Grid.ColumnSpan="4" BorderBrush="#394440" BorderThickness="0.7"/><Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" BorderBrush="#394440" BorderThickness="0.7,0,0.7,0"/><Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" BorderBrush="#394440" BorderThickness="0,0,0.7,0"/><Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" BorderBrush="#394440" BorderThickness="0,0,0.7,0"/>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="2,3"><TextBlock Text="{Binding InvoiceTitle}" FontSize="10" FontWeight="Bold" TextDecorations="Underline" Width="290" TextWrapping="Wrap" Margin="0,0,0,36"/><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Quantity}" FontSize="9" HorizontalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Description}" FontSize="9" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding DiscountText}" FontSize="8" Foreground="#63746B"/></StackPanel><TextBlock Grid.Column="2" FontSize="9" HorizontalAlignment="Right" Margin="0,0,5,0"><TextBlock.Text><MultiBinding StringFormat="{}{0} {1:N2}"><Binding Path="DataContext.CurrencyCode" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="UnitPrice"/></MultiBinding></TextBlock.Text></TextBlock><TextBlock Grid.Column="3" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,5,0"><TextBlock.Text><MultiBinding StringFormat="{}{0} {1:N2}"><Binding Path="DataContext.CurrencyCode" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="Total"/></MultiBinding></TextBlock.Text></TextBlock></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                                </Grid>
                                <Grid Grid.Row="4" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="205"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Top"><TextBlock Text="Payment Details" FontWeight="Bold" FontSize="9"/><TextBlock Text="{Binding PaymentMethod}" FontSize="9" Margin="8,3,0,8"/><TextBlock Text="Due Date" FontWeight="Bold" FontSize="9"/><TextBlock Text="{Binding DueDate}" FontSize="9" Margin="8,3,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="Subtotal" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"><TextBlock.Text><MultiBinding StringFormat="{}{0} {1:N2}"><Binding Path="CurrencyCode"/><Binding Path="Subtotal"/></MultiBinding></TextBlock.Text></TextBlock></Grid>
                                        <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding GetFundRate, StringFormat='GETFUND @ {0}%'}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"><TextBlock.Text><MultiBinding StringFormat="{}{0} {1:N2}"><Binding Path="CurrencyCode"/><Binding Path="GetFundTax"/></MultiBinding></TextBlock.Text></TextBlock></Grid>
                                        <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding NhilRate, StringFormat='NHIL @ {0}%'}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"><TextBlock.Text><MultiBinding StringFormat="{}{0} {1:N2}"><Binding Path="CurrencyCode"/><Binding Path="NhilTax"/></MultiBinding></TextBlock.Text></TextBlock></Grid>
                                        <Border Height="10"/><Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding VatRate, StringFormat='VAT @ {0}%'}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"><TextBlock.Text><MultiBinding StringFormat="{}{0} {1:N2}"><Binding Path="CurrencyCode"/><Binding Path="VatTax"/></MultiBinding></TextBlock.Text></TextBlock></Grid>
                                        <Border BorderBrush="#47514E" BorderThickness="0,1,0,0" Margin="0,2"/><Border Background="#F1F2F1" Padding="3,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="Total" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"><TextBlock.Text><MultiBinding StringFormat="{}{0} {1:N2}"><Binding Path="CurrencyCode"/><Binding Path="GrandTotal"/></MultiBinding></TextBlock.Text></TextBlock></Grid></Border>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="5"><Border Width="155" Height="24" BorderBrush="#8B918E" BorderThickness="0.6" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock FontSize="7.5" FontWeight="SemiBold" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"><TextBlock.Text><MultiBinding StringFormat="TIN NO. {0} / VAT NO. {1}"><Binding Path="TinNumber"/><Binding Path="VatNumber"/></MultiBinding></TextBlock.Text></TextBlock></Grid>
                                <StackPanel Grid.Row="6" VerticalAlignment="Bottom"><Border Height="2" Background="#303B37"/><TextBlock Text="EXPERIENCE A NEW WORLD OF INTERACTION" FontSize="8" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,9,0,0" Foreground="#35413C"/></StackPanel>
                            </Grid>
                        </Border>
                    </Viewbox>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
